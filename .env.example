# Copy to .env (never commit .env). Everything is optional: with nothing set the lab runs
# fully offline on synthetic markets with the offline lesson-memory student.

# ---- LLM student (the "brain" you talk to and watch learn) ----
# openai = any OpenAI-compatible endpoint (OpenAI, OpenRouter, LM Studio, Together...)
# anthropic = Anthropic Messages API
# ollama = local model, no key needed (ollama pull llama3.1)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=60

# ---- Alpaca market data (READ-ONLY; the lab has no order code) ----
# Paper-account keys work. Free feed = iex.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex
ALPACA_DATA_URL=https://data.alpaca.markets
